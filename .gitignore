# Data and generated output — never in git.  These directories hold raw scans,
# derived datasets, training runs and analysis campaigns: tens to hundreds of
# GB of TIFF/zarr/memmap/checkpoint files.  Keep them covered by DIRECTORY
# rules; do not append individual file paths, which go stale the moment a run
# is renamed or deleted.
/data/
/raw_data/
/runs/
/inference/
/diagnostics/
/demo_render/
/best_ddim_300/
/eval_results/

# Python
__pycache__/
*.egg-info/
.ipynb_checkpoints/
